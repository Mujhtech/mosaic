{
  "placementDecisionVersion": "1",
  "ruleSet": {
    "id": "phase5_demo_rule_set",
    "version": 1,
    "projectId": "project_000002",
    "environmentId": "env_000004",
    "environmentKey": "development",
    "placementId": "placement_000001",
    "placementKey": "export_pdf",
    "enabled": true,
    "assignmentPolicy": "installation",
    "attributeDefinitions": [
      {
        "key": "student",
        "type": "boolean",
        "sensitivity": "standard",
        "allowedOperators": [
          "equals",
          "exists"
        ]
      }
    ],
    "fallbacks": [
      {
        "key": "product_unavailable",
        "safeLabel": "Export Product unavailable",
        "outcome": {
          "type": "paywall",
          "paywallVersionId": "version_000004"
        }
      }
    ],
    "rules": [
      {
        "id": "rule_active_pro",
        "priority": 10,
        "enabled": true,
        "safeLabel": "Active Pro access",
        "conditions": {
          "type": "condition",
          "source": {
            "kind": "entitlement_state",
            "key": "pro"
          },
          "operator": "equals",
          "operand": {
            "type": "string",
            "value": "active"
          }
        },
        "outcome": {
          "type": "no_paywall"
        }
      },
      {
        "id": "rule_product_unavailable",
        "priority": 20,
        "enabled": true,
        "safeLabel": "Unavailable Export Product",
        "conditions": {
          "type": "condition",
          "source": {
            "kind": "product_availability",
            "productId": "product_000002"
          },
          "operator": "equals",
          "operand": {
            "type": "string",
            "value": "unavailable"
          }
        },
        "outcome": {
          "type": "fallback",
          "key": "product_unavailable"
        }
      },
      {
        "id": "rule_country_de",
        "priority": 30,
        "enabled": true,
        "safeLabel": "Explicit Germany country",
        "conditions": {
          "type": "condition",
          "source": {
            "kind": "context.country"
          },
          "operator": "equals",
          "operand": {
            "type": "string",
            "value": "DE"
          }
        },
        "outcome": {
          "type": "paywall",
          "paywallVersionId": "version_000002"
        }
      },
      {
        "id": "rule_student",
        "priority": 40,
        "enabled": true,
        "safeLabel": "Student attribute",
        "conditions": {
          "type": "condition",
          "source": {
            "kind": "user_attribute",
            "key": "student"
          },
          "operator": "equals",
          "operand": {
            "type": "boolean",
            "value": true
          }
        },
        "outcome": {
          "type": "paywall",
          "paywallVersionId": "version_000002"
        }
      },
      {
        "id": "rule_minimum_app_version",
        "priority": 50,
        "enabled": true,
        "safeLabel": "Application version 9 or newer",
        "conditions": {
          "type": "condition",
          "source": {
            "kind": "application.version"
          },
          "operator": "greater_than_or_equal",
          "operand": {
            "type": "semantic_version",
            "value": "9.0.0"
          }
        },
        "outcome": {
          "type": "paywall",
          "paywallVersionId": "version_000002"
        }
      },
      {
        "id": "rule_ios",
        "priority": 60,
        "enabled": true,
        "safeLabel": "iOS Paywall A",
        "conditions": {
          "type": "condition",
          "source": {
            "kind": "device.platform"
          },
          "operator": "equals",
          "operand": {
            "type": "string",
            "value": "ios"
          }
        },
        "outcome": {
          "type": "paywall",
          "paywallVersionId": "version_000002"
        }
      },
      {
        "id": "rule_android",
        "priority": 70,
        "enabled": true,
        "safeLabel": "Android Paywall B",
        "conditions": {
          "type": "condition",
          "source": {
            "kind": "device.platform"
          },
          "operator": "equals",
          "operand": {
            "type": "string",
            "value": "android"
          }
        },
        "outcome": {
          "type": "paywall",
          "paywallVersionId": "version_000003"
        }
      },
      {
        "id": "rule_rollout_20_percent",
        "priority": 80,
        "enabled": true,
        "safeLabel": "Deterministic 20 percent rollout",
        "conditions": {
          "type": "condition",
          "source": {
            "kind": "identity.user_present"
          },
          "operator": "equals",
          "operand": {
            "type": "boolean",
            "value": true
          }
        },
        "rollout": {
          "algorithm": "sha256_length_prefixed_v1",
          "thresholdBasisPoints": 2000
        },
        "outcome": {
          "type": "paywall",
          "paywallVersionId": "version_000002"
        }
      }
    ],
    "defaultOutcome": {
      "type": "paywall",
      "paywallVersionId": "version_000001"
    },
    "qaOverrides": [],
    "compatibility": {
      "requiredFeatures": [
        "operator.equals",
        "operator.greater_than_or_equal",
        "outcome.fallback",
        "outcome.no_paywall",
        "outcome.paywall",
        "source.application.version",
        "source.context.country",
        "source.device.platform",
        "source.entitlement_state",
        "source.identity.user_present",
        "source.product_availability",
        "source.user_attribute"
      ],
      "bucketingAlgorithms": [
        "sha256_length_prefixed_v1"
      ]
    }
  }
}
