{
  "name": "@mosaic/dashboard",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:studio": "node scripts/dev-studio.mjs",
    "demo:live": "node scripts/live-preview-demo.mjs",
    "demo:studio-browser": "node scripts/studio-browser-demo.mjs",
    "generate:api": "openapi-ts -i ../../docs/backend/openapi.yaml -o src/generated/api -c @hey-api/client-fetch",
    "preview:relay": "node scripts/local-preview-relay.mjs",
    "build": "vite build",
    "start": "srvx --prod -s ../client dist/server/server.js",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:relay": "node --test scripts/local-preview-relay.test.mjs",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:relay && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@mosaic/design-system": "file:../../packages/design-system",
    "@mosaic/design-tokens": "file:../../packages/design-tokens",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.28",
    "@xyflow/react": "^12.11.2",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.12.2",
    "srvx": "^0.11.22",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@hey-api/openapi-ts": "0.99.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "ultracite": "^7.9.4",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
