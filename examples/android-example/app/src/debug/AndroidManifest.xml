<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Cleartext traffic exists only in the debug build, and only so Local Preview can reach the
      Studio WebSocket on ws://10.0.2.2:4317. The release build has no cleartext permission, and
      the Mosaic library never requests it.
    -->
    <application android:usesCleartextTraffic="true">
        <meta-data
            android:name="com.google.android.play.billingclient.enableBillingOverridesTesting"
            android:value="true" />
    </application>
</manifest>
