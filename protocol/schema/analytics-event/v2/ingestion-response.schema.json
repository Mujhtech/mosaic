{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mosaic:protocol:schema:analytics-event:v2:ingestion-response",
  "title": "Mosaic Analytics Event Contract v2 ingestion response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analyticsEventContractVersion",
    "batchId",
    "receivedAt",
    "results"
  ],
  "properties": {
    "analyticsEventContractVersion": {
      "const": "2"
    },
    "batchId": {
      "$ref": "urn:mosaic:protocol:schema:analytics-event:v2:event#/$defs/identifier"
    },
    "receivedAt": {
      "$ref": "urn:mosaic:protocol:schema:analytics-event:v2:event#/$defs/utcTimestamp"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/eventResult"
      }
    }
  },
  "$defs": {
    "permanentCode": {
      "enum": [
        "event_schema_invalid",
        "unsupported_event_schema",
        "unsupported_event_name",
        "unknown_field",
        "invalid_identifier",
        "invalid_timestamp",
        "occurred_at_too_far_future",
        "event_expired",
        "event_too_large",
        "batch_event_limit_exceeded",
        "duplicate_event_id_in_batch",
        "authority_not_allowed",
        "tenant_field_forbidden",
        "attribution_not_found",
        "attribution_scope_mismatch",
        "event_id_conflict",
        "sensitive_value_rejected"
      ]
    },
    "retryableCode": {
      "enum": [
        "rate_limited",
        "storage_temporarily_unavailable",
        "service_temporarily_unavailable",
        "ingestion_timeout"
      ]
    },
    "eventResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eventId",
            "status"
          ],
          "properties": {
            "eventId": {
              "$ref": "urn:mosaic:protocol:schema:analytics-event:v2:event#/$defs/identifier"
            },
            "status": {
              "const": "accepted"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eventId",
            "status"
          ],
          "properties": {
            "eventId": {
              "$ref": "urn:mosaic:protocol:schema:analytics-event:v2:event#/$defs/identifier"
            },
            "status": {
              "const": "duplicate"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eventId",
            "status",
            "code"
          ],
          "properties": {
            "eventId": {
              "$ref": "urn:mosaic:protocol:schema:analytics-event:v2:event#/$defs/identifier"
            },
            "status": {
              "const": "permanently_rejected"
            },
            "code": {
              "$ref": "#/$defs/permanentCode"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eventId",
            "status",
            "code"
          ],
          "properties": {
            "eventId": {
              "$ref": "urn:mosaic:protocol:schema:analytics-event:v2:event#/$defs/identifier"
            },
            "status": {
              "const": "retryable"
            },
            "code": {
              "$ref": "#/$defs/retryableCode"
            },
            "retryAfterSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            }
          }
        }
      ]
    }
  }
}
