{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mosaic:protocol:schema:analytics-event:v2:compatibility-manifest",
  "title": "Mosaic Analytics Event Contract v2 compatibility manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analyticsEventContractVersion",
    "status",
    "schemas",
    "canonicalFixtures",
    "eventSchemas",
    "limits",
    "readerPolicy"
  ],
  "properties": {
    "analyticsEventContractVersion": {
      "const": "2"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "releaseCandidate",
        "approved",
        "deprecated",
        "retired"
      ]
    },
    "deprecation": {
      "type": "object",
      "description": "Lifecycle metadata present only once this contract version enters the deprecated or retired state. Absent for draft, releaseCandidate, and approved contracts. See docs/protocol/deprecation-policy.md.",
      "additionalProperties": false,
      "required": [
        "deprecatedAt",
        "retiresAt"
      ],
      "properties": {
        "deprecatedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$",
          "description": "UTC calendar date on which this contract version was deprecated."
        },
        "retiresAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$",
          "description": "Earliest UTC calendar date on which this contract version may be retired."
        },
        "supersededBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Identifier of the approved successor contract version, when one exists."
        },
        "migrationGuide": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Repository-relative path to the migration guide for the successor version."
        }
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "batch",
        "ingestionResponse"
      ],
      "properties": {
        "event": {
          "$ref": "#/$defs/relativeJsonPath"
        },
        "batch": {
          "$ref": "#/$defs/relativeJsonPath"
        },
        "ingestionResponse": {
          "$ref": "#/$defs/relativeJsonPath"
        }
      }
    },
    "canonicalFixtures": {
      "type": "array",
      "minItems": 6,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relativeJsonPath"
      }
    },
    "eventSchemas": {
      "type": "array",
      "minItems": 31,
      "maxItems": 31,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventName",
          "supportedVersions",
          "acceptedAuthorities"
        ],
        "properties": {
          "eventName": {
            "$ref": "urn:mosaic:protocol:schema:analytics-event:v2:event#/$defs/eventName"
          },
          "supportedVersions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "const": "2"
            }
          },
          "acceptedAuthorities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "$ref": "urn:mosaic:protocol:schema:analytics-event:v2:event#/$defs/authority"
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxEventsPerBatch",
        "sdkMaxEventsPerBatch",
        "maxEventBytes",
        "maxBatchBytes",
        "eventExpirySeconds",
        "futureSkewSeconds",
        "attributionWindowSeconds"
      ],
      "properties": {
        "maxEventsPerBatch": {
          "const": 100
        },
        "sdkMaxEventsPerBatch": {
          "const": 50
        },
        "maxEventBytes": {
          "const": 32768
        },
        "maxBatchBytes": {
          "const": 524288
        },
        "eventExpirySeconds": {
          "const": 604800
        },
        "futureSkewSeconds": {
          "const": 300
        },
        "attributionWindowSeconds": {
          "const": 86400
        }
      }
    },
    "readerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknownContractVersion",
        "unknownEventSchema",
        "unknownEventName",
        "unknownField",
        "publicSdkAuthority",
        "partialBatch",
        "tenantScope",
        "customMetadata",
        "olderContractVersion"
      ],
      "properties": {
        "unknownContractVersion": {
          "const": "rejectBatch"
        },
        "unknownEventSchema": {
          "const": "permanentlyRejectEvent"
        },
        "unknownEventName": {
          "const": "permanentlyRejectEvent"
        },
        "unknownField": {
          "const": "permanentlyRejectEvent"
        },
        "publicSdkAuthority": {
          "const": "clientObservedOnly"
        },
        "partialBatch": {
          "const": "oneResultPerEvent"
        },
        "tenantScope": {
          "const": "deriveFromAuthentication"
        },
        "customMetadata": {
          "const": "forbidden"
        },
        "olderContractVersion": {
          "const": "acceptAlongsideV2"
        }
      }
    }
  },
  "$defs": {
    "relativeJsonPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\.\\./\\.\\./.*\\.json$"
    }
  }
}
