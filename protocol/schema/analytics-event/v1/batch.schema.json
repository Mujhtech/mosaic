{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mosaic:protocol:schema:analytics-event:v1:batch",
  "title": "Mosaic Analytics Event Contract v1 batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analyticsEventContractVersion",
    "batchId",
    "sentAt",
    "events"
  ],
  "properties": {
    "analyticsEventContractVersion": {
      "const": "1"
    },
    "batchId": {
      "$ref": "urn:mosaic:protocol:schema:analytics-event:v1:event#/$defs/identifier"
    },
    "sentAt": {
      "$ref": "urn:mosaic:protocol:schema:analytics-event:v1:event#/$defs/utcTimestamp"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "urn:mosaic:protocol:schema:analytics-event:v1:event"
      }
    }
  }
}
