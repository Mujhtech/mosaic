{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mosaic:protocol:schema:configuration-delivery:v1:release",
  "title": "Mosaic Configuration Delivery Contract v1",
  "description": "A complete immutable Environment release containing accepted Mosaic Paywall Protocol 0.2 documents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "configurationDeliveryVersion",
    "release"
  ],
  "properties": {
    "configurationDeliveryVersion": {
      "const": "1"
    },
    "release": {
      "$ref": "#/$defs/release"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "placementKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "environmentKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "immutableHttpsUrl": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?(?:[/?#][^\\s\\\\\\u0000-\\u001F\\u007F]*)?$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "key": {
          "$ref": "#/$defs/environmentKey"
        }
      }
    },
    "protocolCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "requiredCapabilities"
      ],
      "properties": {
        "version": {
          "const": "0.2"
        },
        "requiredCapabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:mosaic:protocol:schema:v0.2:paywall#/$defs/requiredCapability"
          }
        }
      }
    },
    "releaseCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paywallProtocols",
        "acceptance"
      ],
      "properties": {
        "paywallProtocols": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/protocolCompatibility"
          }
        },
        "acceptance": {
          "const": "atomic"
        }
      }
    },
    "placementBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "paywallVersionId"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/placementKey"
        },
        "paywallVersionId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "assetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentAssetId",
        "assetReferenceId"
      ],
      "properties": {
        "documentAssetId": {
          "$ref": "#/$defs/identifier"
        },
        "assetReferenceId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "paywallVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "paywallId",
        "protocolVersion",
        "documentDigest",
        "document",
        "productReferenceIds",
        "assetBindings"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "paywallId": {
          "$ref": "#/$defs/identifier"
        },
        "protocolVersion": {
          "const": "0.2"
        },
        "documentDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "document": {
          "$ref": "urn:mosaic:protocol:schema:v0.2:paywall"
        },
        "productReferenceIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "assetBindings": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/assetBinding"
          }
        }
      }
    },
    "productReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "fallbackDisplayName"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "type": "string",
          "enum": [
            "subscription",
            "one_time_non_consumable"
          ]
        },
        "fallbackDisplayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\r\\n\\u0000-\\u001F\\u007F]*$"
        }
      }
    },
    "assetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "mediaType",
        "byteLength",
        "contentDigest",
        "url"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "enum": [
            "image",
            "video"
          ]
        },
        "mediaType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 96,
          "pattern": "^(image|video)/[a-z0-9][a-z0-9.+-]*$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800
        },
        "contentDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "url": {
          "$ref": "#/$defs/immutableHttpsUrl"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "environment",
        "publishedAt",
        "contentDigest",
        "compatibility",
        "placements",
        "paywallVersions",
        "productReferences",
        "assetReferences"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "publishedAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "contentDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "compatibility": {
          "$ref": "#/$defs/releaseCompatibility"
        },
        "placements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/placementBinding"
          }
        },
        "paywallVersions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/paywallVersion"
          }
        },
        "productReferences": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/productReference"
          }
        },
        "assetReferences": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/assetReference"
          }
        }
      }
    }
  }
}
