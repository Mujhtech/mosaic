{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mosaic:protocol:schema:configuration-delivery:v1:compatibility-manifest",
  "title": "Mosaic Configuration Delivery v1 Compatibility Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "configurationDeliveryVersion",
    "status",
    "releaseSchema",
    "capabilityRequestSchema",
    "canonicalFixture",
    "supportedPaywallProtocols",
    "readerPolicy"
  ],
  "properties": {
    "configurationDeliveryVersion": {
      "const": "1"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "releaseCandidate",
        "approved",
        "deprecated",
        "retired"
      ]
    },
    "deprecation": {
      "type": "object",
      "description": "Lifecycle metadata present only once this contract version enters the deprecated or retired state. Absent for draft, releaseCandidate, and approved contracts. See docs/protocol/deprecation-policy.md.",
      "additionalProperties": false,
      "required": [
        "deprecatedAt",
        "retiresAt"
      ],
      "properties": {
        "deprecatedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$",
          "description": "UTC calendar date on which this contract version was deprecated."
        },
        "retiresAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$",
          "description": "Earliest UTC calendar date on which this contract version may be retired."
        },
        "supersededBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Identifier of the approved successor contract version, when one exists."
        },
        "migrationGuide": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Repository-relative path to the migration guide for the successor version."
        }
      }
    },
    "releaseSchema": {
      "const": "../../schema/configuration-delivery/v1/release.schema.json"
    },
    "capabilityRequestSchema": {
      "const": "../../schema/configuration-delivery/v1/capability-request.schema.json"
    },
    "canonicalFixture": {
      "const": "../../fixtures/configuration-delivery/v1/valid-release.json"
    },
    "supportedPaywallProtocols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "const": "0.3"
      }
    },
    "readerPolicy": {
      "$ref": "#/$defs/readerPolicy"
    }
  },
  "$defs": {
    "readerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknownDeliveryVersion",
        "unknownField",
        "unsupportedPaywallProtocol",
        "unsupportedPaywallCapability",
        "invalidReference",
        "invalidDigest",
        "candidateRejected",
        "noAcceptedRelease",
        "bundledReleaseRejected",
        "partialAcceptance",
        "unknownPlacement",
        "assetUnavailable"
      ],
      "properties": {
        "unknownDeliveryVersion": {
          "const": "rejectRelease"
        },
        "unknownField": {
          "const": "rejectRelease"
        },
        "unsupportedPaywallProtocol": {
          "const": "rejectRelease"
        },
        "unsupportedPaywallCapability": {
          "const": "rejectRelease"
        },
        "invalidReference": {
          "const": "rejectRelease"
        },
        "invalidDigest": {
          "const": "rejectRelease"
        },
        "candidateRejected": {
          "const": "keepLastAcceptedRelease"
        },
        "noAcceptedRelease": {
          "const": "loadBundledRelease"
        },
        "bundledReleaseRejected": {
          "const": "configurationUnavailable"
        },
        "partialAcceptance": {
          "const": "forbidden"
        },
        "unknownPlacement": {
          "const": "placementUnavailable"
        },
        "assetUnavailable": {
          "const": "usePaywallDeclaredFallbackAndDiagnose"
        }
      }
    }
  }
}
