{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mosaic:protocol:schema:configuration-delivery:v1:capability-request",
  "title": "Mosaic Configuration Delivery Capability Request v1",
  "description": "The platform-neutral semantic capability metadata sent by an SDK when requesting configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "platform",
    "sdkVersion",
    "supportedConfigurationDeliveryVersions",
    "supportedPaywallProtocols"
  ],
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "flutter",
        "ios",
        "android"
      ]
    },
    "sdkVersion": {
      "$ref": "#/$defs/version"
    },
    "supportedConfigurationDeliveryVersions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      }
    },
    "supportedPaywallProtocols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/supportedPaywallProtocol"
      }
    },
    "applicationVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\r\\n\\u0000-\\u001F\\u007F]*$"
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "supportedCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "$ref": "urn:mosaic:protocol:schema:v0.2:paywall#/$defs/capabilityName"
        },
        "version": {
          "const": "0.2"
        }
      }
    },
    "supportedPaywallProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "capabilities"
      ],
      "properties": {
        "version": {
          "const": "0.2"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/supportedCapability"
          }
        }
      }
    }
  }
}
