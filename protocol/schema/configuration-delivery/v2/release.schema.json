{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mosaic:protocol:schema:configuration-delivery:v2:release",
  "title": "Mosaic Configuration Delivery Contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "configurationDeliveryVersion",
    "release"
  ],
  "properties": {
    "configurationDeliveryVersion": {
      "const": "2"
    },
    "release": {
      "$ref": "#/$defs/release"
    }
  },
  "$defs": {
    "identifier": {
      "$ref": "urn:mosaic:protocol:schema:configuration-delivery:v1:release#/$defs/identifier"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "mode"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "mode": {
          "enum": [
            "development",
            "staging",
            "production"
          ]
        }
      }
    },
    "decisionFeature": {
      "enum": [
        "condition.all",
        "condition.any",
        "condition.not",
        "operator.contains_all",
        "operator.contains_any",
        "operator.does_not_exist",
        "operator.equals",
        "operator.exists",
        "operator.greater_than",
        "operator.greater_than_or_equal",
        "operator.in",
        "operator.less_than",
        "operator.less_than_or_equal",
        "operator.locale_matches",
        "operator.not_equals",
        "operator.not_in",
        "outcome.fallback",
        "outcome.no_paywall",
        "outcome.paywall",
        "outcome.unavailable",
        "override.qa",
        "source.application.locale",
        "source.application.version",
        "source.context.country",
        "source.device.os_version",
        "source.device.platform",
        "source.entitlement_state",
        "source.environment.id",
        "source.environment.key",
        "source.identity.user_present",
        "source.product_availability",
        "source.product_readiness",
        "source.provider_capability",
        "source.user_attribute"
      ]
    },
    "paywallVersion": {
      "$ref": "urn:mosaic:protocol:schema:configuration-delivery:v1:release#/$defs/paywallVersion"
    },
    "assetReference": {
      "$ref": "urn:mosaic:protocol:schema:configuration-delivery:v1:release#/$defs/assetReference"
    },
    "productReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "fallbackDisplayName",
        "readiness"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "subscription",
            "one_time_non_consumable"
          ]
        },
        "fallbackDisplayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\r\\n\\u0000-\\u001F\\u007F]*$"
        },
        "readiness": {
          "enum": [
            "ready",
            "not_ready"
          ]
        }
      }
    },
    "entitlementReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "key": {
          "$ref": "#/$defs/key"
        }
      }
    },
    "decisionCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "requiredFeatures",
        "bucketingAlgorithms"
      ],
      "properties": {
        "version": {
          "const": "1"
        },
        "requiredFeatures": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/decisionFeature"
          }
        },
        "bucketingAlgorithms": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "sha256_length_prefixed_v1"
          }
        }
      }
    },
    "paywallCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "requiredCapabilities"
      ],
      "properties": {
        "version": {
          "const": "0.3"
        },
        "requiredCapabilities": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:mosaic:protocol:schema:v0.3:paywall#/$defs/requiredCapability"
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placementDecisionContracts",
        "paywallProtocols",
        "acceptance"
      ],
      "properties": {
        "placementDecisionContracts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/decisionCompatibility"
          }
        },
        "paywallProtocols": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/paywallCompatibility"
          }
        },
        "acceptance": {
          "const": "atomic"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "projectId",
        "environment",
        "publishedAt",
        "contentDigest",
        "compatibility",
        "placementDecisions",
        "paywallVersions",
        "productReferences",
        "entitlementReferences",
        "assetReferences"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "projectId": {
          "$ref": "#/$defs/identifier"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "publishedAt": {
          "$ref": "urn:mosaic:protocol:schema:configuration-delivery:v1:release#/$defs/utcTimestamp"
        },
        "contentDigest": {
          "$ref": "urn:mosaic:protocol:schema:configuration-delivery:v1:release#/$defs/sha256Digest"
        },
        "compatibility": {
          "$ref": "#/$defs/compatibility"
        },
        "placementDecisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "urn:mosaic:protocol:schema:placement-decision:v1:decision"
          }
        },
        "paywallVersions": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/paywallVersion"
          }
        },
        "productReferences": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/productReference"
          }
        },
        "entitlementReferences": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/entitlementReference"
          }
        },
        "assetReferences": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/assetReference"
          }
        }
      }
    }
  }
}
