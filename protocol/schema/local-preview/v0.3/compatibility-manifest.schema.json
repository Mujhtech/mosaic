{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mosaic:protocol:schema:local-preview:v0.3:compatibility-manifest",
  "title": "Mosaic Local Preview Contract 0.3 compatibility manifest",
  "description": "Development-only contract describing the Local Preview transport and local project file that accompany Paywall Protocol 0.3. Local Preview is never used by a shipped application at runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "localPreviewContractVersion",
    "status",
    "audience",
    "webSocketSubprotocol",
    "previewProtocolVersion",
    "fileFormatVersion",
    "documentProtocol",
    "schemas",
    "canonicalFixtures",
    "messageTypes",
    "previewCapabilities",
    "deliveryDiagnosticCodes",
    "revisionPolicy",
    "readerPolicy"
  ],
  "properties": {
    "localPreviewContractVersion": {
      "const": "0.3"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "releaseCandidate",
        "approved",
        "deprecated",
        "retired"
      ]
    },
    "deprecation": {
      "type": "object",
      "description": "Lifecycle metadata present only once this contract version enters the deprecated or retired state. Absent for draft, releaseCandidate, and approved contracts. See docs/protocol/deprecation-policy.md.",
      "additionalProperties": false,
      "required": [
        "deprecatedAt",
        "retiresAt"
      ],
      "properties": {
        "deprecatedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$",
          "description": "UTC calendar date on which this contract version was deprecated."
        },
        "retiresAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$",
          "description": "Earliest UTC calendar date on which this contract version may be retired."
        },
        "supersededBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Identifier of the approved successor contract version, when one exists."
        },
        "migrationGuide": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Repository-relative path to the migration guide for the successor version."
        }
      }
    },
    "audience": {
      "const": "developmentOnly",
      "description": "Local Preview is a Studio-to-preview-client authoring transport. No shipped application depends on it, so its compatibility runway is bounded by tooling releases rather than by the SDK support window."
    },
    "webSocketSubprotocol": {
      "const": "mosaic.local-preview.v0.3"
    },
    "previewProtocolVersion": {
      "const": "0.3"
    },
    "fileFormatVersion": {
      "const": "0.3"
    },
    "documentProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "compatibilityManifest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.3"
        },
        "compatibilityManifest": {
          "$ref": "#/$defs/relativeJsonPath"
        }
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previewMessage",
        "localProject"
      ],
      "properties": {
        "previewMessage": {
          "$ref": "#/$defs/relativeJsonPath"
        },
        "localProject": {
          "$ref": "#/$defs/relativeJsonPath"
        }
      }
    },
    "canonicalFixtures": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relativeJsonPath"
      }
    },
    "messageTypes": {
      "description": "Exact message taxonomy; must equal the preview-message schema type enumeration.",
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:mosaic:protocol:schema:local-preview:v0.3:message#/properties/type"
      }
    },
    "previewCapabilities": {
      "description": "Exact Local Preview capability set; must equal the preview-message schema capability enumeration, every entry at version 0.3.",
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "$ref": "urn:mosaic:protocol:schema:local-preview:v0.3:message#/$defs/previewCapabilityName"
          },
          "version": {
            "const": "0.3"
          }
        }
      }
    },
    "deliveryDiagnosticCodes": {
      "description": "Complete set of structured diagnostic codes a relay may emit when it withholds a draft.",
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:mosaic:protocol:schema:local-preview:v0.3:message#/$defs/diagnosticCode"
      }
    },
    "revisionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentAndMockCommerceOrdering",
        "acceptedRevisionRuntime",
        "countdownOnAcceptance"
      ],
      "properties": {
        "documentAndMockCommerceOrdering": {
          "const": "independent"
        },
        "acceptedRevisionRuntime": {
          "const": "resetNavigationCarouselSwitchAndSelection"
        },
        "countdownOnAcceptance": {
          "const": "recomputeFromPreviewDeviceClock"
        }
      }
    },
    "readerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unsupportedSubprotocol",
        "unknownPreviewProtocolVersion",
        "unknownFileFormatVersion",
        "malformedCapabilityReport",
        "incompatibleSchemaVersion",
        "unsupportedDocumentCapability",
        "unsupportedPreviewCapability",
        "draftExceedsClientByteLimit",
        "invalidDraft",
        "rejectedRevision",
        "beforeFirstAcceptedRevision",
        "mediaAndDesignTokenResolution",
        "portableExchange"
      ],
      "properties": {
        "unsupportedSubprotocol": {
          "const": "rejectConnection"
        },
        "unknownPreviewProtocolVersion": {
          "const": "rejectConnection"
        },
        "unknownFileFormatVersion": {
          "const": "rejectLocalProject"
        },
        "malformedCapabilityReport": {
          "const": "withholdDraftAtomically"
        },
        "incompatibleSchemaVersion": {
          "const": "withholdDraftAtomically"
        },
        "unsupportedDocumentCapability": {
          "const": "withholdDraftAtomically"
        },
        "unsupportedPreviewCapability": {
          "const": "withholdDraftAtomically"
        },
        "draftExceedsClientByteLimit": {
          "const": "withholdDraftAtomically"
        },
        "invalidDraft": {
          "const": "withholdDraftAtomically"
        },
        "rejectedRevision": {
          "const": "keepLastAcceptedDraft"
        },
        "beforeFirstAcceptedRevision": {
          "const": "showConnectionStateWithoutBundledFallback"
        },
        "mediaAndDesignTokenResolution": {
          "const": "neverPerformedByRelay"
        },
        "portableExchange": {
          "const": "rawProtocol02Json"
        }
      }
    }
  },
  "$defs": {
    "relativeJsonPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\.\\./\\.\\./.*\\.json$"
    }
  }
}
