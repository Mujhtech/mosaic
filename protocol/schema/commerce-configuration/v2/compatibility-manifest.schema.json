{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mosaic:protocol:schema:commerce-configuration:v2:compatibility-manifest",
  "title": "Mosaic Commerce Configuration v2 Compatibility Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commerceConfigurationVersion",
    "status",
    "schema",
    "canonicalFixtures",
    "activationSources",
    "adapterMappingKinds",
    "readerPolicy"
  ],
  "properties": {
    "commerceConfigurationVersion": {
      "const": "2"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "releaseCandidate",
        "approved",
        "deprecated",
        "retired"
      ]
    },
    "deprecation": {
      "type": "object",
      "description": "Lifecycle metadata present only once this contract version enters the deprecated or retired state. Absent for draft, releaseCandidate, and approved contracts. See docs/protocol/deprecation-policy.md.",
      "additionalProperties": false,
      "required": [
        "deprecatedAt",
        "retiresAt"
      ],
      "properties": {
        "deprecatedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$",
          "description": "UTC calendar date on which this contract version was deprecated."
        },
        "retiresAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$",
          "description": "Earliest UTC calendar date on which this contract version may be retired."
        },
        "supersededBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Identifier of the approved successor contract version, when one exists."
        },
        "migrationGuide": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Repository-relative path to the migration guide for the successor version."
        }
      }
    },
    "schema": {
      "type": "string",
      "minLength": 1
    },
    "canonicalFixtures": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "activationSources": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "providerConnection",
          "sdkLocal",
          "nativeStore"
        ]
      }
    },
    "adapterMappingKinds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "directProduct",
          "revenueCatPackage",
          "storeKitProduct",
          "googlePlayProduct"
        ]
      }
    },
    "readerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknownVersion",
        "unknownField",
        "unknownAdapterMapping",
        "releaseAssociationMismatch",
        "digestMismatch",
        "ambiguousMapping",
        "cacheAssociation",
        "credentialMaterial",
        "unsupportedVersion"
      ],
      "properties": {
        "unknownVersion": {
          "const": "rejectSidecar"
        },
        "unknownField": {
          "const": "rejectSidecar"
        },
        "unknownAdapterMapping": {
          "const": "rejectSidecar"
        },
        "releaseAssociationMismatch": {
          "const": "rejectSidecar"
        },
        "digestMismatch": {
          "const": "rejectSidecar"
        },
        "ambiguousMapping": {
          "const": "rejectSidecar"
        },
        "cacheAssociation": {
          "const": "atomicallyWithConfigurationRelease"
        },
        "credentialMaterial": {
          "const": "forbidden"
        },
        "unsupportedVersion": {
          "const": "retainLastAcceptedOrBundledFallback"
        }
      }
    }
  }
}
