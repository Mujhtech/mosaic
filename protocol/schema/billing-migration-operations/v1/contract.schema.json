{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mosaic:protocol:schema:billing-migration-operations:v1:contract",
  "title": "Mosaic Billing Migration Operations Contract v1",
  "description": "Strict operator-facing records and commands for an audited migration. Source evidence never becomes a transaction fact through this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "billingMigrationOperationsContractVersion",
    "recordType",
    "payload"
  ],
  "properties": {
    "billingMigrationOperationsContractVersion": {
      "const": "1"
    },
    "recordType": {
      "enum": [
        "migrationProgram",
        "migrationScope",
        "capabilityAssessment",
        "sourcePullJob",
        "operatorCapabilities",
        "sourceManifest",
        "mappingSet",
        "importBatch",
        "dryRunResult",
        "divergence",
        "readinessAssessment",
        "migrationCheckpoint",
        "migrationApproval",
        "authorityCommand",
        "reconciliationCase",
        "repairAction",
        "completionReport",
        "webhookRedeliveryCommand"
      ]
    },
    "payload": {}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "recordType": {
            "const": "migrationProgram"
          }
        },
        "required": [
          "recordType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/program"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recordType": {
            "const": "migrationScope"
          }
        },
        "required": [
          "recordType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/scopeRecord"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recordType": {
            "const": "capabilityAssessment"
          }
        },
        "required": [
          "recordType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/capabilityAssessment"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recordType": {
            "const": "sourcePullJob"
          }
        },
        "required": [
          "recordType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/sourcePullJob"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recordType": {
            "const": "operatorCapabilities"
          }
        },
        "required": [
          "recordType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/operatorCapabilities"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recordType": {
            "const": "sourceManifest"
          }
        },
        "required": [
          "recordType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/manifest"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recordType": {
            "const": "mappingSet"
          }
        },
        "required": [
          "recordType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/mappingSet"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recordType": {
            "const": "importBatch"
          }
        },
        "required": [
          "recordType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/importBatch"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recordType": {
            "const": "dryRunResult"
          }
        },
        "required": [
          "recordType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/dryRun"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recordType": {
            "const": "divergence"
          }
        },
        "required": [
          "recordType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/divergence"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recordType": {
            "const": "readinessAssessment"
          }
        },
        "required": [
          "recordType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/readiness"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recordType": {
            "const": "migrationCheckpoint"
          }
        },
        "required": [
          "recordType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/checkpoint"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recordType": {
            "const": "migrationApproval"
          }
        },
        "required": [
          "recordType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/approval"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recordType": {
            "const": "authorityCommand"
          }
        },
        "required": [
          "recordType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/authorityCommand"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recordType": {
            "const": "reconciliationCase"
          }
        },
        "required": [
          "recordType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/case"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recordType": {
            "const": "repairAction"
          }
        },
        "required": [
          "recordType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/repair"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recordType": {
            "const": "completionReport"
          }
        },
        "required": [
          "recordType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/completion"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recordType": {
            "const": "webhookRedeliveryCommand"
          }
        },
        "required": [
          "recordType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/redelivery"
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sourceIdentifier": {
      "description": "Exact opaque identifier from the migration source. Unlike Mosaic IDs it may begin with '$' (for example RevenueCat $RCAnonymousID values). It is preserved byte-for-byte; no case folding, trimming, email interpretation, or heuristic normalization is permitted.",
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\r\\n\\u0000-\\u001F\\u007F]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\r\\n\\u0000-\\u001F\\u007F]*$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "platform": {
      "enum": [
        "ios",
        "android"
      ]
    },
    "scopeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationId",
        "platform"
      ],
      "properties": {
        "applicationId": {
          "$ref": "#/$defs/id"
        },
        "platform": {
          "$ref": "#/$defs/platform"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "environmentId",
        "applications"
      ],
      "properties": {
        "projectId": {
          "$ref": "#/$defs/id"
        },
        "environmentId": {
          "$ref": "#/$defs/id"
        },
        "applications": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/scopeItem"
          }
        }
      }
    },
    "base": {
      "type": "object",
      "required": [
        "programId",
        "stateVersion"
      ],
      "properties": {
        "programId": {
          "$ref": "#/$defs/id"
        },
        "stateVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999999999
        }
      }
    },
    "command": {
      "type": "object",
      "required": [
        "programId",
        "idempotencyKey",
        "expectedStateVersion",
        "expectedDigests",
        "reason"
      ],
      "properties": {
        "programId": {
          "$ref": "#/$defs/id"
        },
        "idempotencyKey": {
          "$ref": "#/$defs/id"
        },
        "expectedStateVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999999999
        },
        "expectedDigests": {
          "type": "object"
        },
        "reason": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "programId",
        "stateVersion",
        "state",
        "scope",
        "source",
        "authorityEpochBefore",
        "stabilizationDays",
        "rollbackWindowDays"
      ],
      "properties": {
        "programId": {
          "$ref": "#/$defs/id"
        },
        "stateVersion": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "draft",
            "assessing",
            "mapping",
            "importing",
            "dry_run",
            "shadowing",
            "ready",
            "cutover_pending",
            "stabilizing",
            "completed",
            "rolled_back",
            "failed",
            "cancelled"
          ]
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter",
            "adapterVersion",
            "credentialReference"
          ],
          "properties": {
            "adapter": {
              "const": "revenuecat"
            },
            "adapterVersion": {
              "$ref": "#/$defs/id"
            },
            "credentialReference": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "authorityEpochBefore": {
          "type": "integer",
          "minimum": 0
        },
        "authorityEpochAfter": {
          "type": "integer",
          "minimum": 1
        },
        "stabilizationDays": {
          "description": "Program policy frozen before the first production dry run. The compatibility manifest declares the default; an explicitly reviewed program may choose another bounded value.",
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "rollbackWindowDays": {
          "description": "Program policy frozen before the first production dry run. The compatibility manifest declares the default; an explicitly reviewed program may choose another bounded value.",
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      }
    },
    "scopeRecord": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "programId",
            "stateVersion",
            "scope",
            "scopeDigest"
          ],
          "properties": {
            "programId": {
              "$ref": "#/$defs/id"
            },
            "stateVersion": {
              "type": "integer",
              "minimum": 1
            },
            "scope": {
              "$ref": "#/$defs/scope"
            },
            "scopeDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      ]
    },
    "capabilityAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "programId",
        "stateVersion",
        "adapter",
        "providerApiVersion",
        "capabilities",
        "assessedAt"
      ],
      "properties": {
        "programId": {
          "$ref": "#/$defs/id"
        },
        "stateVersion": {
          "type": "integer",
          "minimum": 1
        },
        "adapter": {
          "const": "revenuecat"
        },
        "providerApiVersion": {
          "$ref": "#/$defs/id"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "read_customers",
              "read_subscriptions",
              "read_aliases",
              "read_transfers",
              "incremental_delta"
            ]
          }
        },
        "assessedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "digest"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/id"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "sourcePullStartingPosition": {
      "description": "Exact source position from which a delta continues. Cursor bytes are opaque; the watermark digest binds the cursor to the stated watermark.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cursor",
        "watermark",
        "watermarkDigest"
      ],
      "properties": {
        "cursor": {
          "$ref": "#/$defs/sourceIdentifier"
        },
        "watermark": {
          "$ref": "#/$defs/sourceIdentifier"
        },
        "watermarkDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "sourcePullResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceObject",
        "manifest",
        "providerValidationImport"
      ],
      "properties": {
        "sourceObject": {
          "$ref": "#/$defs/artifactReference"
        },
        "manifest": {
          "$ref": "#/$defs/artifactReference"
        },
        "providerValidationImport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "digest",
            "status"
          ],
          "properties": {
            "reference": {
              "$ref": "#/$defs/id"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            },
            "status": {
              "enum": [
                "pending",
                "running",
                "completed",
                "failed"
              ]
            }
          }
        },
        "finalDeltaEvaluation": {
          "description": "Server-created evaluation result. It is never requested through a separate public final-delta command.",
          "$ref": "#/$defs/artifactReference"
        }
      }
    },
    "sourcePullJob": {
      "description": "Durable server-returned state for the sourcePull command. A completed final_delta includes the evaluation automatically queued after its provider-validation import settles.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "programId",
        "sourcePullJobId",
        "command",
        "intent",
        "idempotencyKey",
        "expectedStateVersion",
        "status",
        "requestedAt"
      ],
      "properties": {
        "programId": {
          "$ref": "#/$defs/id"
        },
        "sourcePullJobId": {
          "$ref": "#/$defs/id"
        },
        "command": {
          "const": "sourcePull"
        },
        "intent": {
          "enum": [
            "snapshot",
            "delta",
            "final_delta"
          ]
        },
        "idempotencyKey": {
          "$ref": "#/$defs/id"
        },
        "expectedStateVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999999999
        },
        "startingPosition": {
          "$ref": "#/$defs/sourcePullStartingPosition"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "completed",
            "failed"
          ]
        },
        "requestedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "completedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "failedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "failureCode": {
          "$ref": "#/$defs/id"
        },
        "result": {
          "$ref": "#/$defs/sourcePullResult"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "intent": {
                "const": "snapshot"
              }
            },
            "required": [
              "intent"
            ]
          },
          "then": {
            "not": {
              "required": [
                "startingPosition"
              ]
            }
          },
          "else": {
            "required": [
              "startingPosition"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "pending"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "startedAt"
                  ]
                },
                {
                  "required": [
                    "completedAt"
                  ]
                },
                {
                  "required": [
                    "failedAt"
                  ]
                },
                {
                  "required": [
                    "failureCode"
                  ]
                },
                {
                  "required": [
                    "result"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "running"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "startedAt"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "completedAt"
                  ]
                },
                {
                  "required": [
                    "failedAt"
                  ]
                },
                {
                  "required": [
                    "failureCode"
                  ]
                },
                {
                  "required": [
                    "result"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "startedAt",
              "completedAt",
              "result"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "failedAt"
                  ]
                },
                {
                  "required": [
                    "failureCode"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "startedAt",
              "failedAt",
              "failureCode"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "completedAt"
                  ]
                },
                {
                  "required": [
                    "result"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "intent": {
                "const": "final_delta"
              },
              "status": {
                "const": "completed"
              },
              "result": {
                "properties": {
                  "providerValidationImport": {
                    "properties": {
                      "status": {
                        "const": "completed"
                      }
                    },
                    "required": [
                      "status"
                    ]
                  }
                },
                "required": [
                  "providerValidationImport"
                ]
              }
            },
            "required": [
              "intent",
              "status",
              "result"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "required": [
                  "finalDeltaEvaluation"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "result": {
                "not": {
                  "required": [
                    "finalDeltaEvaluation"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "operatorCapabilities": {
      "description": "Server-returned UI affordance evidence for one operator and program state. Possession never substitutes for backend authorization at command execution.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "programId",
        "stateVersion",
        "actorId",
        "capabilities",
        "evaluatedAt"
      ],
      "properties": {
        "programId": {
          "$ref": "#/$defs/id"
        },
        "stateVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999999999
        },
        "actorId": {
          "$ref": "#/$defs/id"
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 15,
          "items": {
            "enum": [
              "view",
              "manage-source",
              "manage-mappings",
              "run-import",
              "assess-readiness",
              "propose-cutover",
              "approve-cutover",
              "execute-cutover",
              "execute-rollback",
              "execute-repair",
              "remove-credential",
              "manage-legal-hold",
              "complete-migration",
              "redeliver-webhook",
              "delete-source"
            ]
          }
        },
        "evaluatedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "programId",
        "stateVersion",
        "manifestId",
        "adapterVersion",
        "providerApiVersion",
        "schemaVersion",
        "recordCount",
        "currentAccessRecordCount",
        "objectChecksum",
        "manifestDigest",
        "capturedAt"
      ],
      "properties": {
        "programId": {
          "$ref": "#/$defs/id"
        },
        "stateVersion": {
          "type": "integer",
          "minimum": 1
        },
        "manifestId": {
          "$ref": "#/$defs/id"
        },
        "adapterVersion": {
          "$ref": "#/$defs/id"
        },
        "providerApiVersion": {
          "$ref": "#/$defs/id"
        },
        "schemaVersion": {
          "$ref": "#/$defs/id"
        },
        "recordCount": {
          "type": "integer",
          "minimum": 0
        },
        "currentAccessRecordCount": {
          "type": "integer",
          "minimum": 0
        },
        "objectChecksum": {
