          "$ref": "#/$defs/timestamp"
        },
        "completionDigest": {
          "$ref": "#/$defs/digest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "legalHold": {
                "const": false
              }
            },
            "required": [
              "legalHold"
            ]
          },
          "then": {
            "required": [
              "sourceObjectsDeleteAt"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "legalHold": {
                "const": true
              }
            },
            "required": [
              "legalHold"
            ]
          },
          "then": {
            "not": {
              "required": [
                "sourceObjectsDeleteAt"
              ]
            }
          }
        }
      ]
    },
