    "repair": {
      "allOf": [
        {
          "$ref": "#/$defs/command"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "programId",
            "idempotencyKey",
            "expectedStateVersion",
            "expectedDigests",
            "reason",
            "repairKind",
            "caseId",
            "scope",
            "actorId",
            "beforeDigest",
            "executionStatus"
          ],
          "properties": {
            "programId": {
              "$ref": "#/$defs/id"
            },
            "idempotencyKey": {
              "$ref": "#/$defs/id"
            },
            "expectedStateVersion": {
              "type": "integer",
              "minimum": 1
            },
            "expectedDigests": {
              "$ref": "#/$defs/repairExpectedDigests"
            },
            "reason": {
              "$ref": "#/$defs/text"
            },
            "repairKind": {
              "enum": [
                "provider_revalidate",
                "projection_replay",
                "attach_proven_alias",
                "replace_mapping_set",
                "retry_quarantined_record"
              ]
            },
            "caseId": {
              "$ref": "#/$defs/id"
            },
            "scope": {
              "$ref": "#/$defs/repairScope"
            },
            "actorId": {
              "$ref": "#/$defs/id"
            },
            "beforeDigest": {
              "$ref": "#/$defs/digest"
            },
            "afterDigest": {
              "$ref": "#/$defs/digest"
            },
            "executionStatus": {
              "enum": [
                "pending",
                "completed"
              ]
            },
            "result": {
              "enum": [
                "succeeded",
                "failed",
                "no_change"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "executionStatus": {
                    "const": "pending"
                  }
                },
                "required": [
                  "executionStatus"
                ]
              },
              "then": {
                "allOf": [
                  {
                    "not": {
                      "required": [
                        "afterDigest"
                      ]
                    }
                  },
                  {
                    "not": {
                      "required": [
                        "result"
                      ]
                    }
                  }
                ]
              },
              "else": {
                "required": [
                  "afterDigest",
                  "result"
                ]
              }
            }
          ]
        }
      ]
    },
