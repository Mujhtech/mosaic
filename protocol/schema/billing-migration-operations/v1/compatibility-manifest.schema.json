{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mosaic:protocol:schema:billing-migration-operations:v1:compatibility-manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "billingMigrationOperationsContractVersion",
    "status",
    "schema",
    "canonicalFixtures",
    "recordTypes",
    "sourcePullConditionVectors",
    "commandPreconditionVectors",
    "commandPreconditions",
    "completionTimingVectors",
    "policy"
