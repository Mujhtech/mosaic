{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mosaic:protocol:schema:experiment-assignment:v1:assignment",
  "title": "Mosaic Experiment Assignment Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experimentAssignmentVersion",
    "assignment"
  ],
  "properties": {
    "experimentAssignmentVersion": {
      "const": "1"
    },
    "assignment": {
      "$ref": "#/$defs/assignment"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "safeLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\r\\n\\u0000-\\u001F\\u007F]*$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "assignmentFeature": {
      "enum": [
        "allocation.ranges",
        "assignment.installation",
        "assignment.identified_user",
        "assignment.identified_user_or_installation",
        "fallback.normal_placement",
        "group.mutual_exclusion",
        "override.qa",
        "schedule.trusted_server_time"
      ]
    },
    "variantCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredProductIds",
        "requiredProviderCapabilities"
      ],
      "properties": {
        "requiredProductIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "requiredProviderCapabilities": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "enum": [
              "product_load",
              "purchase",
              "restore",
              "entitlement_lookup",
              "native_recovery"
            ]
          }
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role",
        "paywallId",
        "paywallVersionId",
        "rangeStart",
        "rangeEnd",
        "compatibility"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/safeLabel"
        },
        "role": {
          "enum": [
            "control",
            "treatment"
          ]
        },
        "paywallId": {
          "$ref": "#/$defs/identifier"
        },
        "paywallVersionId": {
          "$ref": "#/$defs/identifier"
        },
        "rangeStart": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "rangeEnd": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "compatibility": {
          "$ref": "#/$defs/variantCompatibility"
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startsAt",
        "timePolicy",
        "unreliableTimeBehavior"
      ],
      "properties": {
        "startsAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "endsAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "timePolicy": {
          "const": "trusted_server_time_v1"
        },
        "unreliableTimeBehavior": {
          "const": "normal_placement"
        }
      }
    },
    "groupMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experimentId",
        "rangeStart",
        "rangeEnd"
      ],
      "properties": {
        "experimentId": {
          "$ref": "#/$defs/identifier"
        },
        "rangeStart": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "rangeEnd": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "groupRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rangeStart",
        "rangeEnd"
      ],
      "properties": {
        "rangeStart": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "rangeEnd": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "versionId",
        "members",
        "bucketingAlgorithm"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "versionId": {
          "$ref": "#/$defs/identifier"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/groupMember"
          }
        },
        "normalPlacementRange": {
          "$ref": "#/$defs/groupRange"
        },
        "bucketingAlgorithm": {
          "const": "experiment_group_sha256_length_prefixed_v1"
        }
      }
    },
    "qaOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "variantId",
        "assignmentKeyType",
        "selectorDigest",
        "safeLabel",
        "startsAt",
        "expiresAt",
        "visibility"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "variantId": {
          "$ref": "#/$defs/identifier"
        },
        "assignmentKeyType": {
          "enum": [
            "installation",
            "identified_user"
          ]
        },
        "selectorDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "safeLabel": {
          "$ref": "#/$defs/safeLabel"
        },
        "startsAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "visibility": {
          "const": "diagnostic"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredFeatures",
        "bucketingAlgorithms",
        "schedulePolicies"
      ],
      "properties": {
        "requiredFeatures": {
          "type": "array",
          "minItems": 4,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/assignmentFeature"
          }
        },
        "bucketingAlgorithms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "experiment_sha256_length_prefixed_v1",
              "experiment_group_sha256_length_prefixed_v1"
            ]
          }
        },
        "schedulePolicies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "const": "trusted_server_time_v1"
          }
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "environmentId",
        "experimentId",
        "experimentVersionId",
        "placementId",
        "controlPaywallVersionId",
        "allocationVersion",
        "variants",
        "assignmentKeyPolicy",
        "bucketingAlgorithm",
        "lifecycle",
        "schedule",
        "qaOverrides",
        "fallback",
        "compatibility"
      ],
      "properties": {
        "projectId": {
          "$ref": "#/$defs/identifier"
        },
        "environmentId": {
          "$ref": "#/$defs/identifier"
        },
        "experimentId": {
          "$ref": "#/$defs/identifier"
        },
        "experimentVersionId": {
          "$ref": "#/$defs/identifier"
        },
        "placementId": {
          "$ref": "#/$defs/identifier"
        },
        "controlPaywallVersionId": {
          "$ref": "#/$defs/identifier"
        },
        "allocationVersion": {
          "$ref": "#/$defs/identifier"
        },
        "variants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/variant"
          }
        },
        "assignmentKeyPolicy": {
          "enum": [
            "installation",
            "identified_user",
            "identified_user_or_installation"
          ]
        },
        "bucketingAlgorithm": {
          "const": "experiment_sha256_length_prefixed_v1"
        },
        "lifecycle": {
          "enum": [
            "scheduled",
            "running",
            "paused",
            "stopped",
            "completed"
          ]
        },
        "schedule": {
          "$ref": "#/$defs/schedule"
        },
        "mutualExclusionGroup": {
          "$ref": "#/$defs/group"
        },
        "qaOverrides": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/qaOverride"
          }
        },
        "fallback": {
          "const": "normal_placement"
        },
        "compatibility": {
          "$ref": "#/$defs/compatibility"
        }
      }
    }
  }
}
