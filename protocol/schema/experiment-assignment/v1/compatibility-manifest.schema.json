{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mosaic:protocol:schema:experiment-assignment:v1:compatibility-manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experimentAssignmentVersion",
    "status",
    "assignmentSchema",
    "canonicalFixture",
    "conformanceFixture",
    "features",
    "algorithms",
    "schedulePolicies",
    "readerPolicy"
  ],
  "properties": {
    "experimentAssignmentVersion": {
      "const": "1"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "releaseCandidate",
        "approved",
        "deprecated",
        "retired"
      ]
    },
    "deprecation": {
      "type": "object",
      "description": "Lifecycle metadata present only once this contract version enters the deprecated or retired state. Absent for draft, releaseCandidate, and approved contracts. See docs/protocol/deprecation-policy.md.",
      "additionalProperties": false,
      "required": [
        "deprecatedAt",
        "retiresAt"
      ],
      "properties": {
        "deprecatedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$",
          "description": "UTC calendar date on which this contract version was deprecated."
        },
        "retiresAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$",
          "description": "Earliest UTC calendar date on which this contract version may be retired."
        },
        "supersededBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Identifier of the approved successor contract version, when one exists."
        },
        "migrationGuide": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Repository-relative path to the migration guide for the successor version."
        }
      }
    },
    "assignmentSchema": {
      "const": "../../schema/experiment-assignment/v1/assignment.schema.json"
    },
    "canonicalFixture": {
      "const": "../../fixtures/experiment-assignment/v1/running-ab.json"
    },
    "conformanceFixture": {
      "const": "../../fixtures/experiment-assignment/v1/assignment-vectors.json"
    },
    "features": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:mosaic:protocol:schema:experiment-assignment:v1:assignment#/$defs/assignmentFeature"
      }
    },
    "algorithms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "experiment_sha256_length_prefixed_v1",
          "experiment_group_sha256_length_prefixed_v1"
        ]
      }
    },
    "schedulePolicies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "const": "trusted_server_time_v1"
      }
    },
    "readerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknownVersion",
        "unknownField",
        "unsupportedFeature",
        "unsupportedAlgorithm",
        "malformedAllocation",
        "ineligibleOrInactive",
        "partialEvaluation"
      ],
      "properties": {
        "unknownVersion": {
          "const": "rejectCandidate"
        },
        "unknownField": {
          "const": "rejectCandidate"
        },
        "unsupportedFeature": {
          "const": "rejectCandidate"
        },
        "unsupportedAlgorithm": {
          "const": "rejectCandidate"
        },
        "malformedAllocation": {
          "const": "rejectCandidate"
        },
        "ineligibleOrInactive": {
          "const": "normalPlacement"
        },
        "partialEvaluation": {
          "const": "forbidden"
        }
      }
    }
  }
}
