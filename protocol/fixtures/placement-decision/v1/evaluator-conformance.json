          "id": "rule_pro",
          "priority": 10,
          "enabled": true,
          "safeLabel": "Active Pro access",
          "conditions": {
            "type": "condition",
            "source": {
              "kind": "entitlement_state",
              "key": "pro"
            },
            "operator": "equals",
            "operand": {
              "type": "string",
              "value": "active"
            }
          },
          "outcome": {
            "type": "no_paywall"
          }
        },
        {
          "id": "rule_product_unavailable",
          "priority": 20,
          "enabled": true,
          "safeLabel": "Unavailable export Product",
          "conditions": {
            "type": "condition",
            "source": {
              "kind": "product_availability",
              "productId": "product_export_pro"
            },
            "operator": "equals",
            "operand": {
              "type": "string",
              "value": "unavailable"
            }
          },
          "outcome": {
            "type": "fallback",
            "key": "product_unavailable"
          }
        },
        {
          "id": "rule_student_de",
          "priority": 30,
          "enabled": true,
          "safeLabel": "German students",
