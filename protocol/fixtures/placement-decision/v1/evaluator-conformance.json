              },
              {
                "type": "condition",
                "source": {
                  "kind": "user_attribute",
                  "key": "student"
                },
                "operator": "equals",
                "operand": {
                  "type": "boolean",
                  "value": true
                }
              }
            ]
          },
          "outcome": {
            "type": "paywall",
            "paywallVersionId": "paywall_version_student"
          }
        },
        {
          "id": "rule_country_present_but_unusable",
          "priority": 31,
          "enabled": true,
          "safeLabel": "Host-supplied country exists even when it is unusable",
