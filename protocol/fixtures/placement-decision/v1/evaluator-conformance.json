  "cases": [
    {
      "name": "active entitlement wins first priority and no_paywall is success",
      "context": {
        "entitlements": {
          "pro": "active"
        },
        "products": {
          "product_export_pro": "available"
        }
      },
      "assignment": {
        "type": "installation",
        "value": "install_01"
      },
      "expected": {
        "matchedRuleId": "rule_pro",
        "outcome": {
          "type": "no_paywall"
        }
      }
    },
    {
      "name": "unknown entitlement does not become inactive and unavailable Product follows fallback",
