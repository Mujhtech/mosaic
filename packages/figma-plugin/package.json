{
  "name": "@mosaic/figma-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Figma plugin that maps a Figma frame into a Mosaic Paywall Protocol 0.4 document for import into Mosaic Studio.",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "manifest.json",
    "build",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.133.0",
    "@types/node": "^22.19.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
